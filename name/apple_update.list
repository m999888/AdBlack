# Loon Rule List
# 转换为 Loon 可用的 LIST 文件格式

# Apple 系统防更新与资产拦截规则
DOMAIN,ns.itunes.apple.com
DOMAIN,appldnld.apple.com
DOMAIN,mesu.apple.com
DOMAIN,xp.apple.com
DOMAIN,gdmf.apple.com
DOMAIN-SUFFIX,gdmf-ados.apple.com
DOMAIN-SUFFIX,updates.cdn-apple.com
DOMAIN-SUFFIX,updates-http.cdn-apple.com

# 广告与追踪 SDK 拦截
DOMAIN-SUFFIX,iadsdk.apple.com
DOMAIN-SUFFIX,ads.internal.unity3d.com
DOMAIN-SUFFIX,ads.prd.ie.internal.unity3d.com
DOMAIN-SUFFIX,unityads.unity3d.com

# 特定网站拦截
DOMAIN-SUFFIX,jable.tv
DOMAIN-SUFFIX,missav.ws
DOMAIN-KEYWORD,jable
DOMAIN-KEYWORD,missav

# STUN / WebRTC 泄露探测拦截
DEST-PORT,3478
DEST-PORT,19302
DOMAIN-KEYWORD,stun
DOMAIN-KEYWORD,webrtc
